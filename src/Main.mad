import Array from "Array"
import IO from "IO"

import Baton from "@/Baton"
import Might from "@/Might"



mainAlgebraic = () => {
  five = Might.mighty([5])
  seven = Might.mighty([7])
  IO.pTrace("FIVE?", five ++ seven)
  IO.pTrace("FIVE ALIVE?", Might.run(five ++ seven))
  IO.pTrace("HUH", Might.run(Might.for(3, 5, (_) => of({}))))
  IO.pTrace(
    "more",
    pipe(
      pure,
      Might.until,
      Might.run,
    )(true),
  )

  raw = Might.run(Might.whileM(Might.mighty(false), Might.mighty("cool")))
  IO.pTrace("RAWAWAWAW", raw)
  twoThousand = Baton.might(2000)
  IO.pTrace("baton", Might.run(twoThousand))
  IO.pTrace("hooray", Might.run(Baton.grab(Baton.Baton(Array.fromList([2000])))))
  IO.pTrace(
    "hooray * 2",
    Might.run(Baton.change((x) => x * 2, Baton.Baton(Array.fromList([2000])))),
  )

  runner = (limit) => Might.run(
    do {
      b <- Baton.might(0)
      c <- Might.whileM(map((n) => n < limit, Baton.grab(b)), Baton.changeDrop((n) => n + 1, b))
      return Baton.grab(b)
    },
  )
  IO.pTrace("RUNNER: 3", runner(3))
  IO.pTrace("RUNNER: 0", runner(0))
}
greet = (name) => IO.putLine("hello " ++ name)
greetM = (name) => Might.Might(() => greet(name))
twice = (value) => {
  IO.pTrace("unit", value)
  return value
}
twiceM = (value) => do {
  IO.pTrace("might, wrapped, unevaluated", value)
  _ <- map(IO.pTrace("one"), value)
  return map(IO.pTrace("two"), value)
}
mainReadmeExample = () => {
  IO.putLine("START")
  IO.putLine("ONE")
  // runs once
  twice(greet("there"))
  IO.putLine("TWO")
  // runs twice
  Might.run(twiceM(greetM("world")))
}
main = () => {
  IO.pTrace(
    "RAW",
    Might.run(
      do {
        n <- Baton.might(0)
        built = twiceM(Baton.changeDrop((c) => c + 1, n))
        // 0: built, not run
        before <- Baton.grab(n)
        _ <- built
        // 2
        after <- Baton.grab(n)
        return Might.mighty(#[before, after])
      },
    ),
  )
}
