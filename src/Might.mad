import {} from "Applicative"
import Fn from "Function"
import {} from "Functor"
import {} from "Monad"
import {} from "MonadRec"
import Wish from "Wish"



export type Might a = Might({} -> a)
alias Meh = Might {}
export mighty = (e) => Might(() => e)
export run = where {
  Might(f) =>
    f()
}
instance Functor Might {
  map = (fn, m) => Might(() => fn(run(m)))
}
instance Applicative Might {
  ap = (mf, m) => Might(
    () => {
      f = run(mf)
      x = run(m)
      return f(x)
    },
  )

  pure = mighty
}
instance Monad Might {
  chain = (fn, m) => Might(() => run(fn(run(m))))

  of = mighty
}
instance (Semigroup a,
Eq a) => Semigroup (Might a) {
  assoc = (a, b) => chain((x) => map((y) => assoc(x, y), b), a)
}
isLoop = where {
  Fn.Loop(_) =>
    true

  _ =>
    false
}
instance MonadRec Might {
  tailRecM = (fn, a) => Might(
    () => {
      step = run(fn(a))
      while(isLoop(step)) do {
        step := where(step) {
          Fn.Loop(next) =>
            run(fn(next))

          _ =>
            step
        }
      }
      return where(step) {
        Fn.Done(r) =>
          r

        _ =>
          ???
      }
    },
  )
}
until :: Might Boolean -> Meh
export until = (x) => tailRecM(
  (_) => map(
    (done) => if (done) {
      Fn.Done({})
    } else {
      Fn.Loop({})
    },
    x,
  ),
  {},
)
whileM :: Might Boolean -> Might a -> Meh
export whileM = (still, x) => tailRecM(
  (_) => chain(
    (ok) => if (ok) {
      map(() => Fn.Loop({}), x)
    } else {
      mighty(Fn.Done({}))
    },
    still,
  ),
  {},
)
for :: Integer -> Integer -> (Integer -> Meh) -> Meh
export for = (a, z, fn) => tailRecM(
  (i) => if (i >= z) {
    mighty(Fn.Done({}))
  } else {
    map(() => Fn.Loop(i + 1), fn(i))
  },
  a,
)
forEach :: (a -> Meh) -> List a -> Meh
export forEach = (f, xs) => tailRecM(
  where {
    [] =>
      mighty(Fn.Done({}))

    [x, ...rest] =>
      map(() => Fn.Loop(rest), f(x))
  },
  xs,
)
toWishWithCancel :: ({} -> {}) -> Might a -> Wish e a
export toWishWithCancel = (cancel, m) => Wish.Wish(
  (_, goodPath) => {
    goodPath(run(m))
    return cancel
  },
)
toWish :: Might a -> Wish e a
export toWish = toWishWithCancel(() => {})
