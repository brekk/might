Study.report(
  pipe(
    Baton.might,
    Might.run,
  ),
  "Values can be wrapped in Batons can be wrapped in Might",
  [#[200, Baton.baton(200)]],
)
Study.report(
  pipe(
    Baton.grab,
    Might.run,
  ),
  "Batons can be converted to Might",
  [#[Baton.baton(200), 200]],
)
// Study.report(
//   pipe(
//     Baton.set(400),
//     Baton.grab,
//     Might.run,
//   ),
//   "Batons can be set",
//   [#[Baton.baton(200), 400]],
// )
Study.report(
  pipe(
    Baton.change((x) => x * 2),
    Might.run,
  ),
  "Batons can be mapped as they are wrapped in Might",
  [#[Baton.baton(200), 400]],
)
Study.report(
  pipe(
    Baton.changeDrop((x) => x * 2),
    Might.run,
  ),
  "Batons can be mapped as they are wrapped in Might, with an optional explicit return value",
  [#[Baton.baton(200), {}]],
)
